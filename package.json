{
	"name": "comiquero",
	"version": "1.0.0",
	"type": "module",
	"description": "Electrobun app with Svelte and Vite HMR",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary",
		"build:stable": "vite build && electrobun build --env=stable"
	},
	"dependencies": {
		"@imagemagick/magick-wasm": "^0.0.42",
		"ag-psd": "^31.0.2",
		"d3-selection": "^3.0.0",
		"d3-zoom": "^3.0.0",
		"electrobun": "1.18.1",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.0.1",
		"@types/bun": "latest",
		"concurrently": "^9.1.0",
		"svelte": "^5.14.1",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
